[{"id": "S1_P1", "title": "模拟考试 1 · 第 1 题（2 分）", "color": "t1", "subtitle": "25 名员工去年的病假天数", "blocks": [{"t": "p", "text": "25 名员工去年的病假天数（días de baja）。", "b": true, "i": false}, {"t": "datos", "values": [0, 2, 1, 0, 3, 1, 0, 0, 2, 5, 1, 0, 1, 2, 0, 9, 1, 0, 3, 1, 2, 0, 1, 4, 0]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "样本量（n）", "key": 25.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "均值（Media）", "key": 1.56, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": [[3.4285714285714284, "你算的是不同取值的平均。每个取值重复几次就要算几次。"]]}, {"t": "ask", "label": "中位数（Mediana）", "key": 1.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "众数（Moda）", "key": 0.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": [[9.0, "这是最高的频数。众数是有这个频数的那个取值。"]]}, {"t": "ask", "label": "第一四分位数（用 CUARTIL.INC）", "key": 0.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "第三四分位数（用 CUARTIL.INC）", "key": 2.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "方差 S²（课上用的那个）", "key": 4.0864, "dec": 3, "tol": 0.0040864000000000004, "kind": "num", "accept": null, "alts": [[4.256666666666667, "你算的是修正方差（VAR.S）。这里要的是 VAR.P。"], [6.52, "你还要减去均值的平方。"]]}, {"t": "ask", "label": "修正方差 s²（cuasivarianza）", "key": 4.256666666666667, "dec": 3, "tol": 0.004256666666666667, "kind": "num", "accept": null, "alts": [[4.0864, "这是方差（VAR.P）。修正方差是 VAR.S。"]]}, {"t": "ask", "label": "标准差 S（desviación típica）", "key": 2.0214846029589246, "dec": 3, "tol": 0.0020214846029589246, "kind": "num", "accept": null, "alts": [[2.0631690833925043, "你用了 DESVEST.S。课上的标准差是 DESVEST.P。"], [4.0864, "这是方差。标准差是它的平方根。"]]}, {"t": "ask", "label": "变异系数 CV（用小数）", "key": 1.2958234634352082, "dec": 3, "tol": 0.0012958234634352082, "kind": "pct", "accept": null, "alts": [[1.3225442842259643, "CV 里用 DESVEST.P，不用 DESVEST.S。"], [0.7717100579032697, "反了：CV = 标准差 ÷ 均值。"]]}, {"t": "ask", "label": "多于 2 天（más de 2）的员工比例（小数或 %）", "key": 0.2, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": [[0.36, "“Más de 2”（多于 2）不包括 2。"], [5.0, "这是人数。题目要比例：除以 n。"]]}, {"t": "ask", "label": "唯一的异常值是哪个？（上限 C₃ + 1,5·IQR）", "key": 9.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": [[5.0, "要成为异常值，必须大于上限（2 + 1,5·2 = 5）。5 不是。"]]}]}, {"id": "S1_P2", "title": "模拟考试 1 · 第 2 题（2 分）", "color": "t1", "subtitle": "110 名员工的月工资", "blocks": [{"t": "p", "text": "110 名员工的月工资（欧元）。", "b": true, "i": false}, {"t": "tabla", "headers": ["区间", "nᵢ"], "rows": [["[900, 1200]", 12], ["(1200, 1500]", 30], ["(1500, 1800]", 38], ["(1800, 2400]", 24], ["(2400, 3600]", 6]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "n（合计）", "key": 110.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "均值（Media）", "key": 1674.5454545454545, "dec": 2, "tol": 1.6745454545454546, "kind": "num", "accept": null, "alts": [[1830.0, "你把组中值平均了，没有乘以频数。"]]}, {"t": "ask", "label": "方差 S²", "key": 206806.61157024791, "dec": 1, "tol": 206.80661157024792, "kind": "num", "accept": null, "alts": [[3010909.090909091, "你还要减去均值的平方。"], [208703.9199332777, "这是修正方差（除以 n−1）。这里要的是方差。"]]}, {"t": "ask", "label": "标准差 S（desviación típica）", "key": 454.75994939115725, "dec": 2, "tol": 0.45475994939115727, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "变异系数 CV（小数）", "key": 0.2715721739035141, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "众数（区间公式）", "key": 1570.5882352941176, "dec": 2, "tol": 1.5705882352941176, "kind": "num", "accept": null, "alts": [[1609.090909090909, "你用了频数。组距不同时，众数组要按密度选。"]]}, {"t": "ask", "label": "中位数（Mediana）", "key": 1602.6315789473683, "dec": 2, "tol": 1.6026315789473684, "kind": "num", "accept": null, "alts": [[1650.0, "这是区间的组中值。用公式：Linf + (n/2 − Nᵢ₋₁)/nᵢ · aᵢ。"]]}, {"t": "ask", "label": "从哪个值开始就进入了最高的 10%？", "key": 2275.0, "dec": 2, "tol": 2.275, "kind": "num", "accept": null, "alts": [[1175.0, "这是第 10 百分位数。“最上面的 10%”从第 90 百分位数开始。"]]}]}, {"id": "S1_P3", "title": "模拟考试 1 · 第 3 题（2 分）", "color": "t2", "subtitle": "班次和满意度", "blocks": [{"t": "p", "text": "140 名员工，按班次（行：Mañana 早班、Tarde 下午班、Noche 夜班）和满意度（列：Alta 高、Media 中、Baja 低）分类。", "b": true, "i": false}, {"t": "tabla", "headers": ["班次 \\ 满意度", "Alta", "Media", "Baja"], "rows": [["Mañana", 18, 22, 10], ["Tarde", 12, 20, 18], ["Noche", 6, 10, 24]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "n（合计）", "key": 140.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "边缘分布：“Media”的合计", "key": 52.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "f₁₁（Mañana 并且 Alta 的比例，小数）", "key": 0.12857142857142856, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "f₁. × f.₁（如果独立应该是多少）", "key": 0.09183673469387756, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "在 Noche（夜班）的人中，“Baja”的比例是多少？（Satisfacción | Turno = Noche）", "key": 0.6, "dec": 3, "tol": 0.0006, "kind": "pct", "accept": null, "alts": [[0.17142857142857143, "条件分布要除以这一行的合计，不是除以 n。"], [0.46153846153846156, "这是 Turno | Satisfacción：你除以了列的合计。"]]}, {"t": "ask", "label": "在“Alta”的人中，Tarde（下午班）的比例是多少？（Turno | Satisfacción = Alta）", "key": 0.3333333333333333, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": [[0.24, "这是按行的条件分布。这里只看那一列。"], [0.08571428571428572, "除以列的合计，不是除以 n。"]]}, {"t": "ask", "label": "它们独立吗？（写 Sí / No，或 是 / 否）", "key": "No", "dec": 2, "tol": null, "kind": "text", "accept": ["NO", "否", "不", "不是", "不独立"], "alts": [["SI", "在所有格子里比较 fᵢⱼ 和 fᵢ.×f.ⱼ（或者比较每一行的 %）。"], ["SÍ", "在所有格子里比较 fᵢⱼ 和 fᵢ.×f.ⱼ（或者比较每一行的 %）。"], ["是", "在所有格子里比较 fᵢⱼ 和 fᵢ.×f.ⱼ（或者比较每一行的 %）。"], ["独立", "在所有格子里比较 fᵢⱼ 和 fᵢ.×f.ⱼ（或者比较每一行的 %）。"]]}]}, {"id": "S1_P4", "title": "模拟考试 1 · 第 4 题（2 分）", "color": "t3", "subtitle": "培训和生产率", "blocks": [{"t": "p", "text": "8 个人的培训小时数（X）和生产率得分（Y）。", "b": true, "i": false}, {"t": "tabla", "headers": ["X", "Y"], "rows": [[5.0, 62.0], [8.0, 65.0], [10.0, 70.0], [12.0, 71.0], [15.0, 76.0], [18.0, 80.0], [20.0, 79.0], [25.0, 88.0]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "X 的均值", "key": 14.125, "dec": 2, "tol": 0.014125, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "Y 的均值", "key": 73.875, "dec": 2, "tol": 0.073875, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "协方差（Covarianza）", "key": 49.265625, "dec": 2, "tol": 0.049265625, "kind": "num", "accept": null, "alts": [[56.30357142857143, "你用了 COVARIANZA.M（除以 n−1）。课上用 COVARIANZA.P（英文版：COVARIANCE.P）。"]]}, {"t": "ask", "label": "斜率 b（Y 对 X 的直线）", "key": 1.2677925211097707, "dec": 3, "tol": 0.0012677925211097708, "kind": "num", "accept": null, "alts": [[0.7714705162711035, "这是 X 对 Y 的斜率。PENDIENTE 里先写 Y：=PENDIENTE(Y;X)。"], [7.903074776490386, "b = Sxy / Sx²（X 的方差，不是标准差）。"]]}, {"t": "ask", "label": "截距 a（término independiente）", "key": 55.96743063932449, "dec": 2, "tol": 0.055967430639324495, "kind": "num", "accept": null, "alts": [[-42.86738438952777, "这是 X 对 Y 的直线的截距。用 =INTERSECCION.EJE(Y;X)（英文版：INTERCEPT）。"]]}, {"t": "ask", "label": "相关系数 r", "key": 0.9889714610569907, "dec": 3, "tol": 0.0009889714610569907, "kind": "num", "accept": null, "alts": [[0.9780645507851989, "这是 R²。r 是它的平方根（符号和 b 一样）。"]]}, {"t": "ask", "label": "决定系数 R²（小数）", "key": 0.9780645507851989, "dec": 3, "tol": 0.000978064550785199, "kind": "pct", "accept": null, "alts": [[0.9889714610569907, "这是 r。R² 是 r 的平方。"]]}, {"t": "ask", "label": "X = 22 时 Y 的预测值", "key": 83.85886610373944, "dec": 2, "tol": 0.08385886610373945, "kind": "num", "accept": null, "alts": [[-25.895033031563493, "你用了 X 对 Y 的直线。"]]}, {"t": "ask", "label": "直线不能解释的 Y 的变异百分比", "key": 0.02193544921480106, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": [[0.9780645507851989, "这是能解释的百分比（R²）。不能解释的是 1 − R²。"]]}]}, {"id": "S1_P5", "title": "模拟考试 1 · 第 5 题（2 分）", "color": "t4", "subtitle": "购物篮和实际工资", "blocks": [{"t": "p", "text": "一篮子商品：基期（2020）和 2025 年的价格和数量。", "b": true, "i": false}, {"t": "tabla", "headers": ["商品", "p₀", "q₀", "pₜ", "qₜ"], "rows": [["A", 2.0, 50.0, 2.4, 45.0], ["B", 5.0, 20.0, 5.5, 22.0], ["C", 1.5, 80.0, 1.8, 70.0]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "拉氏价格指数（Laspeyres）", "key": 116.875, "dec": 2, "tol": 0.116875, "kind": "num", "accept": null, "alts": [[116.39344262295081, "这是帕氏指数。拉氏用基期的数量（q₀）。"], [85.56149732620321, "反了：分子是 2025 年的价格。"]]}, {"t": "ask", "label": "帕氏价格指数（Paasche）", "key": 116.39344262295081, "dec": 2, "tol": 0.11639344262295082, "kind": "num", "accept": null, "alts": [[116.875, "这是拉氏指数。帕氏用当期的数量（qₜ）。"]]}, {"t": "ask", "label": "费雪指数（Fisher）", "key": 116.6339727804784, "dec": 2, "tol": 0.1166339727804784, "kind": "num", "accept": null, "alts": []}, {"t": "p", "text": "月工资（欧元）和 IPC（消费者价格指数，2022 = 100）：", "b": true, "i": false}, {"t": "tabla", "headers": ["年", "工资", "IPC"], "rows": [[2022, 2100, 100], [2023, 2200, 102.0], [2024, 2250, 105.6], [2025, 2330, 109.8]]}, {"t": "ask", "label": "2025 年的实际工资（按 2022 年的欧元）", "key": 2122.040072859745, "dec": 2, "tol": 2.122040072859745, "kind": "num", "accept": null, "alts": [[2558.34, "平减（deflactar）要除以 IPC（× 100）。"]]}, {"t": "ask", "label": "2022-2025 名义变化（小数）", "key": 0.10952380952380958, "dec": 4, "tol": 0.00010952380952380959, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "2022-2025 实际变化（小数）", "key": 0.010495272790354893, "dec": 4, "tol": 5.1000000000000006e-05, "kind": "pct", "accept": null, "alts": [[0.011523809523809714, "百分比不能相减：把实际工资和 2022 年的比较。"]]}]}, {"id": "S2_P1", "title": "模拟考试 2 · 第 1 题（2 分）", "color": "t1", "subtitle": "每名员工的子女数", "blocks": [{"t": "p", "text": "28 名员工的子女数。", "b": true, "i": false}, {"t": "datos", "values": [1, 0, 2, 2, 1, 3, 0, 1, 1, 2, 4, 0, 1, 2, 1, 0, 3, 1, 2, 1, 0, 2, 1, 6, 1, 0, 2, 1]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "样本量（n）", "key": 28.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "均值（Media）", "key": 1.4642857142857142, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": [[2.6666666666666665, "你算的是不同取值的平均。每个取值重复几次就要算几次。"]]}, {"t": "ask", "label": "中位数（Mediana）", "key": 1.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "众数（Moda）", "key": 1.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": [[11.0, "这是最高的频数。众数是有这个频数的那个取值。"]]}, {"t": "ask", "label": "第一四分位数（用 CUARTIL.INC）", "key": 1.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "第三四分位数（用 CUARTIL.INC）", "key": 2.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "方差 S²（课上用的那个）", "key": 1.7487244897959182, "dec": 3, "tol": 0.0017487244897959183, "kind": "num", "accept": null, "alts": [[1.8134920634920633, "你算的是修正方差（VAR.S）。这里要的是 VAR.P。"], [3.892857142857143, "你还要减去均值的平方。"]]}, {"t": "ask", "label": "修正方差 s²（cuasivarianza）", "key": 1.8134920634920633, "dec": 3, "tol": 0.0018134920634920633, "kind": "num", "accept": null, "alts": [[1.7487244897959182, "这是方差（VAR.P）。修正方差是 VAR.S。"]]}, {"t": "ask", "label": "标准差 S（desviación típica）", "key": 1.3223934701124012, "dec": 3, "tol": 0.001322393470112401, "kind": "num", "accept": null, "alts": [[1.3466595945123114, "你用了 DESVEST.S。课上的标准差是 DESVEST.P。"], [1.7487244897959182, "这是方差。标准差是它的平方根。"]]}, {"t": "ask", "label": "变异系数 CV（用小数）", "key": 0.903097979588957, "dec": 3, "tol": 0.000903097979588957, "kind": "pct", "accept": null, "alts": [[0.9196699669840176, "CV 里用 DESVEST.P，不用 DESVEST.S。"], [1.107299565054002, "反了：CV = 标准差 ÷ 均值。"]]}, {"t": "ask", "label": "多于 1 个（más de 1）的员工比例（小数或 %）", "key": 0.39285714285714285, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": [[0.7857142857142857, "“Más de 1”（多于 1）不包括 1。"], [11.0, "这是人数。题目要比例：除以 n。"]]}]}, {"id": "S2_P2", "title": "模拟考试 2 · 第 2 题（2 分）", "color": "t1", "subtitle": "上班路上的时间", "blocks": [{"t": "p", "text": "100 个人上班路上的分钟数。", "b": true, "i": false}, {"t": "tabla", "headers": ["区间", "nᵢ"], "rows": [["[0, 10]", 14], ["(10, 20]", 26], ["(20, 30]", 31], ["(30, 45]", 19], ["(45, 90]", 10]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "n（合计）", "key": 100.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "均值（Media）", "key": 26.225, "dec": 2, "tol": 0.026225000000000002, "kind": "num", "accept": null, "alts": [[30.0, "你把组中值平均了，没有乘以频数。"]]}, {"t": "ask", "label": "方差 S²", "key": 290.8118749999999, "dec": 1, "tol": 0.2908118749999999, "kind": "num", "accept": null, "alts": [[978.5625, "你还要减去均值的平方。"], [293.74936868686854, "这是修正方差（除以 n−1）。这里要的是方差。"]]}, {"t": "ask", "label": "标准差 S（desviación típica）", "key": 17.05320717636421, "dec": 2, "tol": 0.017053207176364212, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "变异系数 CV（小数）", "key": 0.6502652879452511, "dec": 3, "tol": 0.0006502652879452511, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "众数（区间公式）", "key": 22.142857142857142, "dec": 2, "tol": 0.02214285714285714, "kind": "num", "accept": null, "alts": [[22.941176470588236, "你用了频数。组距不同时，众数组要按密度选。"]]}, {"t": "ask", "label": "中位数（Mediana）", "key": 23.225806451612904, "dec": 2, "tol": 0.023225806451612905, "kind": "num", "accept": null, "alts": [[25.0, "这是区间的组中值。用公式：Linf + (n/2 − Nᵢ₋₁)/nᵢ · aᵢ。"]]}, {"t": "ask", "label": "从哪个值开始就进入了最高的 25%？", "key": 33.1578947368421, "dec": 2, "tol": 0.0331578947368421, "kind": "num", "accept": null, "alts": [[14.23076923076923, "这是第 25 百分位数。“最上面的 25%”从第 75 百分位数开始。"]]}]}, {"id": "S2_P3", "title": "模拟考试 2 · 第 3 题（2 分）", "color": "t1", "subtitle": "按性别的工资", "blocks": [{"t": "p", "text": "各组的平均工资（欧元）。给你每组的人数、均值和标准差（不是方差）。", "b": true, "i": false}, {"t": "tabla", "headers": ["组", "人数 T", "均值（Media）", "标准差"], "rows": [["Mujeres", 60, 1980.0, 310.0], ["Hombres", 90, 2240.0, 420.0]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "哪一组更均匀？（写出组名，用西班牙语）", "key": "Mujeres", "dec": 2, "tol": null, "kind": "text", "accept": ["Mujeres", "女性", "女"], "alts": []}, {"t": "ask", "label": "总均值", "key": 2136.0, "dec": 2, "tol": 2.136, "kind": "num", "accept": null, "alts": [[2110.0, "你把均值直接平均了，没有按每组人数加权。"]]}, {"t": "ask", "label": "组内方差", "key": 144280.0, "dec": 1, "tol": 144.28, "kind": "num", "accept": null, "alts": [[376.0, "你用了标准差。要先平方（变成方差）。"]]}, {"t": "ask", "label": "组间方差", "key": 16224.0, "dec": 1, "tol": 16.224, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "总方差", "key": 160504.0, "dec": 1, "tol": 160.504, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "总标准差", "key": 400.6295046548619, "dec": 2, "tol": 0.40062950465486186, "kind": "num", "accept": null, "alts": [[160504.0, "这是方差。开平方。"]]}, {"t": "ask", "label": "来自组间差别的变异百分比", "key": 0.10108159298210637, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": [[0.8989184070178936, "这是组内的百分比。"]]}, {"t": "p", "text": "如果所有工资都涨 2%，再加 30 欧元：", "b": true, "i": false}, {"t": "ask", "label": "新的总均值", "key": 2208.7200000000003, "dec": 2, "tol": 2.2087200000000005, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "新的总方差", "key": 166988.3616, "dec": 1, "tol": 166.98836160000002, "kind": "num", "accept": null, "alts": [[163714.08000000002, "方差乘以 a²（不是乘以 a）。"]]}]}, {"id": "S2_P4", "title": "模拟考试 2 · 第 4 题（2 分）", "color": "t3", "subtitle": "缺勤和满意度", "blocks": [{"t": "p", "text": "9 个人每年缺勤天数（X）和满意度 0-10（Y）。", "b": true, "i": false}, {"t": "tabla", "headers": ["X", "Y"], "rows": [[2.0, 8.4], [3.0, 8.1], [5.0, 7.2], [6.0, 7.4], [8.0, 6.1], [9.0, 6.3], [11.0, 5.0], [12.0, 5.2], [14.0, 4.1]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "X 的均值", "key": 7.777777777777778, "dec": 2, "tol": 0.0077777777777777776, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "Y 的均值", "key": 6.4222222222222225, "dec": 2, "tol": 0.006422222222222222, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "协方差（Covarianza）", "key": -5.306172839506182, "dec": 2, "tol": 0.005306172839506182, "kind": "num", "accept": null, "alts": [[-5.969444444444455, "你用了 COVARIANZA.M（除以 n−1）。课上用 COVARIANZA.P（英文版：COVARIANCE.P）。"]]}, {"t": "ask", "label": "斜率 b（Y 对 X 的直线）", "key": -0.35229508196721376, "dec": 3, "tol": 0.00051, "kind": "num", "accept": null, "alts": [[-2.757956878850107, "这是 X 对 Y 的斜率。PENDIENTE 里先写 Y：=PENDIENTE(Y;X)。"], [-1.3672375782672277, "b = Sxy / Sx²（X 的方差，不是标准差）。"]]}, {"t": "ask", "label": "截距 a（término independiente）", "key": 9.162295081967219, "dec": 2, "tol": 0.009162295081967219, "kind": "num", "accept": null, "alts": [[25.489989733059577, "这是 X 对 Y 的直线的截距。用 =INTERSECCION.EJE(Y;X)（英文版：INTERCEPT）。"]]}, {"t": "ask", "label": "相关系数 r", "key": -0.9857051509942207, "dec": 3, "tol": 0.0009857051509942207, "kind": "num", "accept": null, "alts": [[0.9857051509942207, "注意符号：r 的符号和斜率一样。"]]}, {"t": "ask", "label": "决定系数 R²（小数）", "key": 0.9716146446965395, "dec": 3, "tol": 0.0009716146446965395, "kind": "pct", "accept": null, "alts": [[-0.9857051509942207, "这是 r。R² 是 r 的平方。"]]}, {"t": "ask", "label": "X = 10 时 Y 的预测值", "key": 5.639344262295081, "dec": 2, "tol": 0.005639344262295082, "kind": "num", "accept": null, "alts": [[-2.0895790554414937, "你用了 X 对 Y 的直线。"]]}, {"t": "ask", "label": "直线不能解释的 Y 的变异百分比", "key": 0.028385355303460535, "dec": 3, "tol": 0.00051, "kind": "pct", "accept": null, "alts": [[0.9716146446965395, "这是能解释的百分比（R²）。不能解释的是 1 − R²。"]]}]}, {"id": "S2_P5", "title": "模拟考试 2 · 第 5 题（2 分）", "color": "t4", "subtitle": "指数和变化率", "blocks": [{"t": "p", "text": "一家公司的年销售额（千欧元）。", "b": true, "i": false}, {"t": "hint", "text": "以 2020 为基期的指数 = 值/2020 年的值 × 100。变化率 = 值/前一年 − 1。年平均变化率 = (1 + 总变化率)^(1/年数) − 1。"}, {"t": "trabajo", "headers": ["年", "销售额", "指数（基期 2020）", "比上一年的变化率", "指数（基期 2022）"], "given": [[2020, 1250], [2021, 1300], [2022, 1365], [2023, 1350], [2024, 1420]], "keys": [[100.0, 0.0, 91.57509157509158], [104.0, 0.040000000000000036, 95.23809523809523], [109.2, 0.050000000000000044, 100.0], [108.0, -0.01098901098901095, 98.9010989010989], [113.6, 0.051851851851851816, 104.02930402930404]], "hints": ["=B/B$2020*100", "=B/前一个B−1", "=指数/2022年指数*100"], "dec": [2, 4, 2]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "2020-2024 总变化率（小数）", "key": 0.1359999999999999, "dec": 4, "tol": 0.0001359999999999999, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "2020-2024 年平均变化率（小数）", "key": 0.032391886619581145, "dec": 4, "tol": 5.1000000000000006e-05, "kind": "pct", "accept": null, "alts": [[0.032715710215710236, "你算的是变化率的算术平均。要用几何平均：(1+T)^(1/4) − 1。"], [0.033999999999999975, "不是把变化率除以 4：(1+T)^(1/4) − 1。"], [0.025830639140963285, "从 2020 到 2024 是 4 年，不是 5 年。"]]}]}, {"id": "S3_P1", "title": "模拟考试 3 · 第 1 题（2 分）", "color": "tx", "subtitle": "20 名员工的培训课程", "blocks": [{"t": "p", "text": "一家公司 20 名员工去年上过的培训课程数。", "b": true, "i": false}, {"t": "datos", "values": [0, 1, 1, 2, 2, 2, 3, 1, 0, 2, 4, 2, 1, 3, 2, 1, 0, 2, 3, 5]}, {"t": "hint", "text": "在纸上做：频数表，列出 xᵢ、nᵢ、Nᵢ、xᵢ·nᵢ 和 xᵢ²·nᵢ。中位数和四分位数用讲义里的方法。"}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "均值（Media）", "key": 1.85, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": [[2.5, "你算的是不同取值的平均。每个取值重复几次就要算几次。"]]}, {"t": "ask", "label": "中位数（讲义的方法）", "key": 2.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "众数（Moda）", "key": 2.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": [[7, "这是最高的频数。众数是有这个频数的那个取值。"]]}, {"t": "ask", "label": "第一四分位数 C₁（讲义的方法）", "key": 1.0, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "第三四分位数 C₃（讲义的方法）", "key": 2.5, "dec": 2, "tol": 0.0051, "kind": "num", "accept": null, "alts": [[2, "3n/4 = 15 正好相等时，方法是：取第 15 个和第 16 个数据的平均。"]]}, {"t": "ask", "label": "方差 S²（除以 n）", "key": 1.6274999999999995, "dec": 3, "tol": 0.0016274999999999996, "kind": "num", "accept": null, "alts": [[1.7131578947368415, "这是修正方差（除以 n − 1）。题目要的是方差 S²，除以 n。"], [5.05, "你还要减去均值的平方。"]]}, {"t": "ask", "label": "变异系数 CV（用小数）", "key": 0.6895865309282742, "dec": 3, "tol": 0.0006895865309282742, "kind": "num", "accept": null, "alts": [[0.8797297297297294, "CV 用标准差 S（方差的平方根），不用方差。"]]}, {"t": "ask", "label": "在 Excel 里，方差 S²（除以 n 的那个）用什么函数？只写函数名（西班牙语版）。", "key": "VAR.P", "dec": 0, "tol": 0, "kind": "text", "accept": ["VAR.P", "VARP"], "alts": [["VAR.S", "VAR.S 除以 n − 1：是修正方差。"], ["VAR", "VAR 是旧版的 VAR.S（除以 n − 1）。"], ["DESVEST.P", "这是标准差，不是方差。"]]}], "paper": true}, {"id": "S3_P2", "title": "模拟考试 3 · 第 2 题（2 分）", "color": "tx", "subtitle": "区间里的工资", "blocks": [{"t": "p", "text": "一家连锁店 80 名员工的月工资（欧元）。", "b": true, "i": false}, {"t": "tabla", "headers": ["工资（欧元）", "nᵢ"], "rows": [["[1000, 1200]", 10], ["(1200, 1400]", 25], ["(1400, 1800]", 30], ["(1800, 2400]", 15]]}, {"t": "hint", "text": "注意：区间宽度不一样。求众数要用密度。"}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "平均工资", "key": 1537.5, "dec": 2, "tol": 1.5375, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "中位数（Mediana）", "key": 1466.6666666666667, "dec": 2, "tol": 1.4666666666666668, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "众数（用密度）", "key": 1320.0, "dec": 2, "tol": 1.32, "kind": "num", "accept": null, "alts": [[1500.0, "你用了频数。组距不同时，众数组是密度最大的那个（nᵢ ÷ aᵢ）。"]]}, {"t": "ask", "label": "第 90 百分位数", "key": 2080.0, "dec": 2, "tol": 2.08, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "挣 1600 欧元以上的员工比例（小数）", "key": 0.375, "dec": 4, "tol": 0.000375, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "在 Excel 里，哪个函数能数出每个区间有多少数据（一次写在几个单元格里的那个）？写西班牙语版的名字。", "key": "FRECUENCIA", "dec": 0, "tol": 0, "kind": "text", "accept": ["FRECUENCIA", "FREQUENCY"], "alts": [["CONTAR.SI", "CONTAR.SI 数的是某一个值。区间要用 FRECUENCIA（英文版：FREQUENCY），或者 CONTAR.SI.CONJUNTO。"], ["CONTAR.SI.CONJUNTO", "它也可以数一个区间，但一次算出全部的是 FRECUENCIA。"]]}], "paper": true}, {"id": "S3_P3", "title": "模拟考试 3 · 第 3 题（2 分）", "color": "tx", "subtitle": "性别和工作时间类型", "blocks": [{"t": "p", "text": "100 名员工，按性别（行：Hombre 男、Mujer 女）和工作时间类型（列：Completa 全职、Parcial 兼职、Por horas 按小时）分类。", "b": true, "i": false}, {"t": "tabla", "headers": ["性别 \\ 工作时间", "Completa", "Parcial", "Por horas"], "rows": [["Hombre", 18, 12, 10], ["Mujer", 12, 22, 26]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "有多少员工是兼职（jornada parcial）？（边缘分布）", "key": 34.0, "dec": 0, "tol": 0.51, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "女性中兼职的百分比，占全部女性（小数）", "key": 0.36666666666666664, "dec": 4, "tol": 0.00036666666666666667, "kind": "pct", "accept": null, "alts": [[0.22, "你除以了总数（100）。条件分布要除以那一组的合计：女性。"], [0.6470588235294118, "你除以了列的合计。“女性中”（de las mujeres）= 女性那一行。"]]}, {"t": "ask", "label": "全职员工中男性的百分比（小数）", "key": 0.6, "dec": 4, "tol": 0.0006, "kind": "pct", "accept": null, "alts": [[0.45, "你除以了男性人数。“全职员工中”（de los de jornada completa）= 全职那一列。"]]}, {"t": "ask", "label": "如果独立，Mujer–Parcial 这一格的期望频数", "key": 20.4, "dec": 2, "tol": 0.020399999999999998, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "它们独立吗？写 SI 或 NO（也可以写 是 / 否）。", "key": "NO", "dec": 0, "tol": 0, "kind": "text", "accept": ["NO", "否", "不", "不是", "不独立"], "alts": [["SI", "把 Mujer–Parcial 这一格（22）和它的期望值比较：不一样，所以不独立。"], ["是", "把 Mujer–Parcial 这一格（22）和它的期望值比较：不一样，所以不独立。"], ["独立", "把 Mujer–Parcial 这一格（22）和它的期望值比较：不一样，所以不独立。"]]}, {"t": "ask", "label": "在 Excel 里，用什么工具从数据做出双向表？（西班牙语：tabla dinámica）", "key": "TABLA DINAMICA", "dec": 0, "tol": 0, "kind": "text", "accept": ["TABLA DINAMICA", "TABLAS DINAMICAS", "TABLA DINÁMICA", "数据透视表", "透视表", "PIVOT TABLE", "PIVOTTABLE"], "alts": []}], "paper": true}, {"id": "S3_P4", "title": "模拟考试 3 · 第 4 题（2 分）", "color": "tx", "subtitle": "用求和数据做回归", "blocks": [{"t": "p", "text": "10 名员工的培训小时数（X）和绩效评估得分（Y）。只给你求和：", "b": true, "i": false}, {"t": "tabla", "headers": ["n", "Σx", "Σy", "Σx²", "Σy²", "Σxy"], "rows": [[10, 50, 300, 290, 9300, 1580]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "协方差 S_XY", "key": 8.0, "dec": 3, "tol": 0.008, "kind": "num", "accept": null, "alts": [[158.0, "你还要减去 x̄·ȳ。"]]}, {"t": "ask", "label": "Y 对 X 的直线的斜率 b", "key": 2.0, "dec": 3, "tol": 0.002, "kind": "num", "accept": null, "alts": [[0.26666666666666666, "你除以了 Y 的方差。Y 对 X 要除以 S²ₓ。"]]}, {"t": "ask", "label": "截距 a（término independiente）", "key": 20.0, "dec": 3, "tol": 0.02, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "相关系数 r", "key": 0.7302967433402214, "dec": 3, "tol": 0.0007302967433402215, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "决定系数 R²（小数）", "key": 0.5333333333333332, "dec": 3, "tol": 0.0005333333333333333, "kind": "pct", "accept": null, "alts": []}, {"t": "ask", "label": "培训 7 小时的预测得分", "key": 34.0, "dec": 2, "tol": 0.034, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "在 Excel 里，哪个函数给出直线的斜率？（写西班牙语版的名字）", "key": "PENDIENTE", "dec": 0, "tol": 0, "kind": "text", "accept": ["PENDIENTE", "SLOPE"], "alts": [["INTERSECCION.EJE", "这个给的是截距 a，不是斜率。"]]}], "paper": true}, {"id": "S3_P5", "title": "模拟考试 3 · 第 5 题（2 分）", "color": "tx", "subtitle": "指数和平减", "blocks": [{"t": "p", "text": "指数和平减。", "b": true, "i": false}, {"t": "p", "text": "一家公司的销售额 2023 年变化 +20%，2024 年 −10%，2025 年 +15%。基期 2022 = 100。", "b": false, "i": false}, {"t": "p", "text": "一份工资从 1500 欧元（2022）涨到 1650 欧元（2025）。以 2022 为基期，2025 年的 IPC 是 108。", "b": false, "i": false}, {"t": "tabla", "headers": ["商品", "p₂₀₂₂", "q₂₀₂₂", "p₂₀₂₅"], "rows": [["A", 1.2, 50, 1.3], ["B", 2.0, 20, 2.6]]}, {"t": "h", "text": "问题"}, {"t": "ask", "label": "2025 年的销售指数（基期 2022 = 100）", "key": 124.19999999999999, "dec": 2, "tol": 0.12419999999999999, "kind": "num", "accept": null, "alts": [[125, "你把百分比加起来了。要相乘：1,20 × 0,90 × 1,15。"]]}, {"t": "ask", "label": "2022-2025 年平均增长率（小数）", "key": 0.07491436130478402, "dec": 4, "tol": 7.491436130478402e-05, "kind": "pct", "accept": null, "alts": [[0.08333333333333333, "你除以了 3。平均变化率是总增长的立方根，再减 1。"]]}, {"t": "ask", "label": "2025 年的工资，按 2022 年的欧元（实际）", "key": 1527.7777777777778, "dec": 2, "tol": 1.527777777777778, "kind": "num", "accept": null, "alts": [[1782.0000000000002, "你乘了 IPC。平减要除：1650 ÷ 108 × 100。"]]}, {"t": "ask", "label": "2022-2025 工资的实际变化（小数）", "key": 0.0185185185185186, "dec": 4, "tol": 5.1000000000000006e-05, "kind": "pct", "accept": null, "alts": [[0.1, "这是名义变化（1650 ÷ 1500 − 1）。实际变化用平减后的工资。"]]}, {"t": "ask", "label": "2025 年拉氏价格指数（基期 2022 = 100）", "key": 117.0, "dec": 2, "tol": 0.117, "kind": "num", "accept": null, "alts": []}, {"t": "ask", "label": "在 Excel 里，哪个函数计算几何平均？（写西班牙语版的名字）", "key": "MEDIA.GEOM", "dec": 0, "tol": 0, "kind": "text", "accept": ["MEDIA.GEOM", "MEDIAGEOM", "GEOMEAN"], "alts": []}], "paper": true}]